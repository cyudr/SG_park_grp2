# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LTA_ACCOUNT_KEY / LTA_DATAMALL_ACCOUNT_KEY: LTA DataMall API Account Key for live bus arrivals (v3), live carpark lot availability (v2), traffic incidents, and MRT/LRT alerts.
# Register at: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=
LTA_DATAMALL_ACCOUNT_KEY=

# NPARKS_CROWD_API_KEY / CROWD_MONITOR_API_KEY: NParks Safe Distance & Real-Time Crowd Monitoring API Key
# Enables live park crowd density sensors, visitor capacity percentage, and park congestion telemetry.
NPARKS_CROWD_API_KEY=
CROWD_MONITOR_API_KEY=
